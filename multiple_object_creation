CLASS zcl_7417_instances IMPLEMENTATION.


  METHOD if_oo_adt_classrun~main.
    DATA connections  TYPE TABLE OF REF TO lcl_connection.
    DATA connection TYPE REF TO lcl_connection. "declare a reference variable
    "FIRST INSTANCE
    connection = NEW #( ). "create of object of lcl_connection class
*    CREATE OBJECT connection. "old way
    connection->carrier_id = 'LH'.
    connection->connection_id = '0400'.
    APPEND connection TO connections.
    "SECOND INSTANCE
    connection = NEW #( ).
    connection->carrier_id = 'RH'.
    connection->connection_id = '0300'.
    APPEND connection TO connections.
    "THIRD INSTANCE
    connection = NEW #( ).
    connection->carrier_id = 'BA'.
    connection->connection_id = '0500'.
    APPEND connection TO connections.
    LOOP AT connections INTO DATA(conn).
      out->write( conn->connection_id ).
    ENDLOOP.
  ENDMETHOD.
